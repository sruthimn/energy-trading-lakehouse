# Copy this file to terraform.tfvars and fill it in.
# terraform.tfvars is ignored by git. Never commit real values.

subscription_id     = "00000000-0000-0000-0000-000000000000"
resource_group_name = "your-existing-resource-group"

# The shared SQL server. Not created by Terraform.
sql_server_fqdn   = "your-shared-server.database.windows.net"
sql_database_name = "your-database"
sql_admin_login   = "your-sql-login"
