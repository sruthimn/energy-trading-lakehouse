# Copy this file to terraform.tfvars and fill it in.
# terraform.tfvars is ignored by git. Never commit your real values.

subscription_id     = "00000000-0000-0000-0000-000000000000"
resource_group_name = "your-existing-resource-group"

# Optional. Your public IP address (search "what is my ip"), to reach Azure SQL
# from your own machine. Leave it empty if you do not need that yet.
allowed_client_ip = ""
